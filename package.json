  "version": "1.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --config vite.runtime.config.ts --mode background && vite build --config vite.runtime.config.ts --mode content",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
